# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填入你的真实密钥
# .env 已被 .gitignore 忽略，不会提交到 Git
# ============================================

# 数据库
DB_HOST=localhost
DB_NAME=campus_canteen
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# 阿里云 OSS
ALIOSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIOSS_ACCESS_KEY_ID=your_access_key_id
ALIOSS_ACCESS_KEY_SECRET=your_access_key_secret
ALIOSS_BUCKET_NAME=your_bucket_name

# 微信
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key

# 阿里云 DashScope（向量嵌入）
DASHSCOPE_API_KEY=your_dashscope_api_key
